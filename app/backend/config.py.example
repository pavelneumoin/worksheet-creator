# Optional compatibility configuration. Keep credentials in the root .env
# (ignored by Git) or environment variables, never in this file.
import os

GIGACHAT_CREDENTIALS = os.environ.get('GIGACHAT_CREDENTIALS', '')
GIGACHAT_SCOPE = os.environ.get('GIGACHAT_SCOPE', 'GIGACHAT_API_PERS')
GIGACHAT_MODEL = os.environ.get('GIGACHAT_MODEL', 'GigaChat-3-Ultra')

# The adapter also reads these environment variables:
# GIGACHAT_BASE_URL=https://api.giga.chat/v1
# GIGACHAT_CA_BUNDLE_FILE=/absolute/path/to/trusted-ca-bundle.pem
# TLS certificate verification is always enabled.
# Choose a model available to your account; this project tested 3-Ultra.
