# Copy to .env in the repository root. Never commit .env or real credentials.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Ultra
GIGACHAT_BASE_URL=https://api.giga.chat/v1
# Absolute path to the application CA bundle described in RUN.md.
# Keep TLS verification enabled; the application does not support disabling it.
GIGACHAT_CA_BUNDLE_FILE=
# Optional absolute path; otherwise a local XeLaTeX/pdfLaTeX is detected.
LATEX_COMPILER=
LATEX_TIMEOUT_SECONDS=60
# MAX token is only read by the server; it validates launch signatures.
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_APP_URL=
# Server defaults to MAX authentication. run_local.py explicitly enables loopback-only local accounts.
# LISTOK_AUTH_MODE=max
# Optional persistent SQLite path (Docker sets /app/data/worksheets.db).
LISTOK_DB_PATH=
LISTOK_JOBS_DIR=
LISTOK_GENERATED_DIR=
